DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/netra
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
# Self-registration (POST /api/auth/register). Off unless set to true; otherwise an administrator
# creates accounts with scripts/netra_users.py (docs/DEMO_DATA.md).
ALLOW_PUBLIC_REGISTRATION=false
# Password reset email (SMTP). Port 465 = implicit TLS; any other port must support STARTTLS.
# Until EMAIL_HOST, EMAIL_FROM and FRONTEND_BASE_URL are set, /api/auth/forgot-password returns 503.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM="NETRA <no-reply@example.com>"
# Public frontend origin used to build reset links: ${FRONTEND_BASE_URL}/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Dataset CSV upload caps (validation only). A reverse proxy must allow at least this request size.
IMPORT_MAX_UPLOAD_BYTES=26214400
IMPORT_MAX_ROWS=100000
