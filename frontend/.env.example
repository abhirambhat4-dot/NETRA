# FastAPI base URL without the trailing /api. Required for production builds
# (e.g. https://api.example.com); the dev server falls back to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000
# true = bundled demo data, no backend calls. Leave false (or unset) for production.
VITE_USE_MOCKS=false
